include LICENSE README.md CONTRIBUTING.md install.py package.json package-lock.json .gitignore .gitattributes
recursive-include .github *.yml
recursive-include docs *.md
recursive-include examples *.yaml
recursive-include tests *.py
recursive-include schematic_renderer *.cjs
prune output
prune node_modules
prune .venv
prune .local-artifacts
include output/.gitkeep
